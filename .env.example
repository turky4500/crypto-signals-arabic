# انسخ هذا الملف إلى .env واملأه محلياً — الملف .env مُستبعد في .gitignore.
# في GitHub Actions تُوضع هذه القيم في: Settings → Secrets and variables → Actions
# ⚠️ لا ترفع أي توكن أو سر إلى المستودع إطلاقاً.

# رابط Telegram Bot أو Discord Webhook للإشعار بالإشارات الجديدة فقط.
# اتركه فارغاً لتعطيل الإشعارات (وهو الافتراضي).
#   Telegram: https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT_ID>
#   Discord : https://discord.com/api/webhooks/<ID>/<TOKEN>
NOTIFY_WEBHOOK=

# رابط النسخة المنشورة من signals.json — يُستخدم لحساب عمر الإشارة
# وتحديد أيها "جديد" بدون تخزين أي حالة داخل المستودع.
SIGNALS_STATE_URL=https://turky4500.github.io/crypto-signals-arabic/signals.json

# تجاوز نهاية Binance (مفيد فقط إذا كانت api.binance.com محجوبة في منطقتك).
# الافتراضي فارغ = يجرّب الماسح قائمة النهايات تلقائياً بترتيب الأولوية.
BINANCE_ENDPOINT=

# مستوى السجل: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
